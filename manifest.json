{
  "manifest_version": 2,
  "name": "SupaDupa Mail-Prüfung",
  "description": "Prüft E-Mail-Text, Anhänge und Dateinamen — und repariert falsche oder fehlende Empfänger-Angaben.",
  "version": "1.0.12",
  "author": "SupaDupa Money",
  "browser_specific_settings": {
    "gecko": {
      "id": "mailcheck@supadupa.money",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "messagesImport",
    "addressBooks",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "browser_action": {
    "default_title": "E-Mail-Prüfung",
    "default_icon": {
      "32": "icons/check-32.svg"
    }
  },
  "message_display_action": {
    "default_title": "Diese E-Mail prüfen",
    "default_icon": {
      "32": "icons/check-32.svg"
    }
  },
  "icons": {
    "32": "icons/check-32.svg"
  },
  "content_security_policy": "script-src 'self'; object-src 'self' blob:; frame-src 'self' blob:; img-src 'self' blob: data:"
}
